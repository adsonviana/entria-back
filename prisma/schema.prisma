datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

generator dbml {
  provider = "prisma-dbml-generator"
}

enum UserType {
  ADMIN
  CLIENT
  ORGANIZER
}

enum States {
  AC
  AL
  AP
  AM
  BA
  CE
  DF
  ES
  GO
  MA
  MT
  MS
  MG
  PA
  PB
  PR
  PE
  PI
  RJ
  RN
  RS
  RO
  RR
  SC
  SP
  SE
  TO
} 

enum TicketBatchType {
  PROMOTIONAL
  FIRST
  SECOND
  THIRD
  FINAL
}

enum TicketType {
  PISTA
  VIP
  CAMAROTE
  BACKSTAGE
  OPEN_BAR
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum TicketStatus {
  AVAILABLE
  RESERVED
  PAID
  CANCELLED
  USED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  FINISHED
  CANCELLED
}

model Admin {
  id                String @id
  createdAt         DateTime
  updatedAt         DateTime
  
  user              User   @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Client {
  id                String @id
  orders            Order[]
  createdAt         DateTime
  updatedAt         DateTime

  user User         @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Organizer {
  id                String @id
  events            Event[]
  createdAt         DateTime
  updatedAt         DateTime

  user User         @relation(fields: [id], references: [id], onDelete: Cascade)
}


model User {
  id                String  @id @default(uuid())
  name              String
  email             String  @unique
  password          String
  type              UserType

  admin             Admin?
  client            Client?
  organizer         Organizer?
}

model Event {
  id                String  @id @default(uuid())
  organizerId       String
  title             String
  description       String
  bannerURL         String
  status            EventStatus @default(DRAFT)
  locationName      String
  cep               String
  street            String
  number            String
  neighborhood      String
  city              String
  state             States
  capacity          Int
  artists           Artist[]
  startTime         DateTime
  endTime           DateTime
  createdAt         DateTime
  updatedAt         DateTime

  organizer         Organizer @relation(fields:[organizerId], references: [id])
}

model Artist {
  id                String @id @default(uuid())
  name              String
  description       String
  bannerURL         String
  profilePictureURL String
  upcomingEvents    Event[]
  createdAt         DateTime
  updatedAt         DateTime
}

model Order {
  id                String @id @default(uuid())
  status            OrderStatus @default(PENDING)
  tickets           Ticket[]
  totalAmount       Int
  clientId          String
  eventId           String
  createdAt         DateTime
  updatedAt         DateTime

  client            Client @relation(fields:[clientId], references: [id])
  event             Event @relation(fields:[eventId], references: [id])
}

model Ticket {
  id                String @id @default(uuid())
  status            TicketStatus @default(RESERVED)
  code              String @unique
  batch             TicketBatch
  type              TicketType
  price             Int
  clientId          String
  eventId           String
  orderId           String
  qrCodePDF         String
  createdAt         DateTime
  updatedAt         DateTime

  client            Client @relation(fields: [clientId], references: [id])
  event             Event @relation(fields: [eventId], references: [id])
  order             Order @relation(fields: [orderId], references: [id])
}

model TicketBatch {
  id                Int @id @default(autoincrement())
  eventId           String
  batchType         TicketBatchType
  quantityTotal     Int
  quantitySold      Int
  price             Int
  salesStartAt      DateTime
  salesEndAt        DateTime
  createdAt         DateTime

  event             Event @relation(fields: [eventId], references: [id])
}

model CheckIn {
  id                String @id @default(uui())
  ticketId          String
  checkedInAt       DateTime

  ticket            Ticket @relation(fields: [ticketId], references: [id])
}